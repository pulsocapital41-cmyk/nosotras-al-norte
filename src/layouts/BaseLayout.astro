---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date | string;
  author?: string;
}

const {
  title = 'Nosotras al Norte CDMX — Historias, derechos y vida cotidiana',
  description = 'Periodismo ciudadano, relatos barriales, derechos de las mujeres y vida comunitaria en el norte de la Ciudad de México.',
  image = '/logo-nosotras.png',
  type = 'website',
  pubDate,
  author = 'Redacción Nosotras al Norte',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://nosotrasalnorte.com.mx');

const siteUrl = 'https://nosotrasalnorte.com.mx';

const jsonLd = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL.toString(),
      },
      headline: title,
      description: description,
      image: [image.startsWith('http') ? image : new URL(image, siteUrl).toString()],
      datePublished: pubDate ? new Date(pubDate).toISOString() : new Date().toISOString(),
      dateModified: pubDate ? new Date(pubDate).toISOString() : new Date().toISOString(),
      author: [
        {
          '@type': 'Person',
          name: author,
        },
      ],
      publisher: {
        '@type': 'NewsMediaOrganization',
        name: 'Nosotras al Norte CDMX',
        url: siteUrl,
        logo: {
          '@type': 'ImageObject',
          url: `${siteUrl}/logo-horizontal.png`,
        },
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'NewsMediaOrganization',
      name: 'Nosotras al Norte CDMX',
      url: siteUrl,
      logo: `${siteUrl}/logo-horizontal.png`,
      description: description,
    };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Nosotras al Norte CDMX" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Nosotras al Norte CDMX" />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Google Fonts: Playfair Display (Serif) & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,500;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  
    <!-- Search Engine & Google News Directives -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
