---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('noticias');
const sortedArticles = allArticles.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Lead story: first featured or first sorted
const leadArticle = sortedArticles.find((a) => a.data.featured) || sortedArticles[0];
const leadSlug = leadArticle ? (leadArticle.id ? leadArticle.id.replace(/\.md$/, '') : leadArticle.slug) : '';

// The rest of stories
const feedArticles = sortedArticles.filter((a) => a !== leadArticle);

const formattedLeadDate = leadArticle
  ? new Intl.DateTimeFormat('es-MX', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'America/Mexico_City',
    }).format(new Date(leadArticle.data.pubDate))
  : '';
---

<BaseLayout
  title="Nosotras al Norte CDMX — Historias, derechos y vida cotidiana"
  description="Blog editorial y periodismo ciudadano desde el norte de la Ciudad de México. Relatos de vida, derechos de las mujeres, comunidad y resistencia barrial."
>
  <!-- HERO LEAD STORY (Blogxer Style) -->
  {leadArticle && (
    <section class="hero-lead">
      <div class="container">
        <div class="lead-card">
          <div class="lead-media">
            <a href={`/noticias/${leadSlug}`} class="lead-media-link" aria-label={`Leer historia: ${leadArticle.data.title}`}>
              <img
                src={leadArticle.data.image}
                alt={leadArticle.data.imageCaption || leadArticle.data.title}
                class="lead-img"
                fetchpriority="high"
                loading="eager"
              />
            </a>
          </div>

          <div class="lead-content">
            <div class="lead-badge-row">
              <span class="lead-tag">★ Historia Destacada</span>
              <span class="lead-read-time">{leadArticle.data.readTime || '5 min'} de lectura</span>
            </div>

            <h1 class="lead-title">
              <a href={`/noticias/${leadSlug}`}>{leadArticle.data.title}</a>
            </h1>

            <p class="lead-excerpt">
              {leadArticle.data.excerpt || leadArticle.data.subtitle}
            </p>

            <div class="lead-footer">
              <div class="lead-author">
                <span class="author-circle" aria-hidden="true">♀</span>
                <div>
                  <strong class="author-label">{leadArticle.data.author}</strong>
                  <time datetime={new Date(leadArticle.data.pubDate).toISOString()} class="lead-date">{formattedLeadDate}</time>
                </div>
              </div>

              <a href={`/noticias/${leadSlug}`} class="lead-cta-btn">
                <span>Leer historia completa</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- MANIFIESTO BANNER -->
  <section class="manifesto-section" id="manifiesto">
    <div class="container">
      <div class="manifesto-card">
        <span class="manifesto-icon">🌸</span>
        <blockquote class="manifesto-quote">
          "Hacer visible lo que la prisa de la ciudad oculta. Nosotras al Norte es un espacio de escucha, memoria y derechos para las mujeres que habitamos, cuidamos y transformamos los barrios del norte de la capital."
        </blockquote>
        <span class="manifesto-sub">— Redacción Nosotras al Norte CDMX</span>
      </div>
    </div>
  </section>

  <!-- THE BLOG STREAM (Historias Recientes) -->
  <section class="blog-stream" id="historias">
    <div class="container">
      <div class="stream-header">
        <div class="stream-header__left">
          <span class="stream-pill">Cuaderno de Historias</span>
          <h2 class="stream-title">Relatos, Crónicas y Voces del Norte</h2>
        </div>
        <p class="stream-subtitle">
          Narrativas en primera persona, luchas comunitarias y reflexiones cotidianas.
        </p>
      </div>

      <div class="blog-grid">
        {feedArticles.map((article, index) => (
          <BlogCard article={article} priority={index < 2} />
        ))}
      </div>
    </div>
  </section>

  <!-- BUZÓN COMUNITARIO (Contacto / CTA) -->
  <section class="buzon-section" id="contacto">
    <div class="container">
      <div class="buzon-card">
        <div class="buzon-content">
          <span class="buzon-tag">Buzón Abierto</span>
          <h3 class="buzon-title">¿Tienes una historia o testimonio del norte de la CDMX?</h3>
          <p class="buzon-desc">
            Este blog se construye con las voces de quienes caminan sus calles, defienden sus parques, cuidan sus hogares y levantan la voz. Escríbenos directamente a nuestro buzón editorial.
          </p>
          <a href="mailto:contacto@nosotrasalnorte.com.mx" class="buzon-btn">
            <span>Enviar mensaje a la redacción</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO LEAD */
  .hero-lead {
    padding-block: 2.5rem 2rem;
  }

  .lead-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 200ms ease, border-color 200ms ease;
  }

  .lead-card:hover {
    box-shadow: var(--shadow-md);
    border-color: rgba(199, 67, 104, 0.4);
  }

  @media (max-width: 880px) {
    .lead-card {
      grid-template-columns: 1fr;
    }
  }

  .lead-media-link {
    display: block;
    height: 100%;
    min-height: 380px;
    overflow: hidden;
  }

  .lead-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .lead-card:hover .lead-img {
    transform: scale(1.03);
  }

  .lead-content {
    padding: 2.8rem 2.4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .lead-content {
      padding: 1.8rem 1.4rem;
    }
  }

  .lead-badge-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1.2rem;
  }

  .lead-tag {
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--color-wine);
    color: #FFFFFF;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-pill);
  }

  .lead-read-time {
    font-size: 0.8rem;
    color: var(--color-muted);
    font-weight: 500;
  }

  .lead-title {
    font-size: 2.1rem;
    font-family: var(--font-serif);
    color: var(--color-wine-dark);
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  @media (max-width: 640px) {
    .lead-title {
      font-size: 1.6rem;
    }
  }

  .lead-title a:hover {
    color: var(--color-magenta);
  }

  .lead-excerpt {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-soft);
    margin-bottom: 2rem;
  }

  .lead-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .lead-author {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .author-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-pink-soft);
    color: var(--color-magenta);
    font-weight: bold;
    font-size: 1.1rem;
  }

  .author-label {
    display: block;
    font-size: 0.85rem;
    color: var(--color-wine);
  }

  .lead-date {
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  .lead-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-magenta);
    color: #FFFFFF;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 12px rgba(199, 67, 104, 0.25);
    transition: all 160ms ease;
  }

  .lead-cta-btn:hover {
    background: var(--color-magenta-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(199, 67, 104, 0.35);
  }

  /* MANIFESTO */
  .manifesto-section {
    padding-block: 1.5rem;
  }

  .manifesto-card {
    background: linear-gradient(135deg, #FAF0F3 0%, #FFFFFF 100%);
    border: 1px solid rgba(199, 67, 104, 0.2);
    border-left: 4px solid var(--color-magenta);
    border-radius: var(--radius-md);
    padding: 2.2rem 2.8rem;
    text-align: center;
  }

  @media (max-width: 640px) {
    .manifesto-card {
      padding: 1.5rem 1.2rem;
    }
  }

  .manifesto-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 0.8rem;
  }

  .manifesto-quote {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--color-wine-dark);
    line-height: 1.6;
    max-width: 820px;
    margin-inline: auto;
    margin-bottom: 0.8rem;
  }

  @media (max-width: 640px) {
    .manifesto-quote {
      font-size: 1.05rem;
    }
  }

  .manifesto-sub {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-magenta);
  }

  /* BLOG STREAM */
  .blog-stream {
    padding-block: 3rem 4rem;
  }

  .stream-header {
    margin-bottom: 2.2rem;
  }

  .stream-pill {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-magenta);
    background: var(--color-pink-soft);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    margin-bottom: 0.5rem;
  }

  .stream-title {
    font-size: 1.9rem;
    font-family: var(--font-serif);
    color: var(--color-wine-dark);
    margin-bottom: 0.4rem;
  }

  .stream-subtitle {
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 640px) {
    .blog-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  /* BUZON */
  .buzon-section {
    padding-bottom: 4rem;
  }

  .buzon-card {
    background: var(--color-wine);
    color: #FFFFFF;
    border-radius: var(--radius-lg);
    padding: 3.5rem 2.5rem;
    text-align: center;
    background-image: radial-gradient(circle at top right, rgba(199, 67, 104, 0.4) 0%, transparent 60%);
  }

  .buzon-content {
    max-width: 640px;
    margin-inline: auto;
  }

  .buzon-tag {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(255, 255, 255, 0.15);
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1rem;
    color: #F8D8E0;
  }

  .buzon-title {
    font-size: 1.85rem;
    font-family: var(--font-serif);
    color: #FFFFFF;
    margin-bottom: 0.8rem;
    line-height: 1.3;
  }

  .buzon-desc {
    font-size: 0.95rem;
    color: #EBDCE0;
    line-height: 1.6;
    margin-bottom: 1.8rem;
  }

  .buzon-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #FFFFFF;
    color: var(--color-wine-dark);
    font-weight: 700;
    font-size: 0.92rem;
    padding: 0.85rem 1.8rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    transition: all 160ms ease;
  }

  .buzon-btn:hover {
    background: var(--color-pink-soft);
    color: var(--color-magenta);
    transform: translateY(-2px);
  }
</style>
