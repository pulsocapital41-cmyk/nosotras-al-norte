---
interface Props {
  article: {
    id?: string;
    slug?: string;
    data: {
      title: string;
      subtitle?: string;
      excerpt?: string;
      category?: string;
      author?: string;
      pubDate: Date;
      image: string;
      imageCaption?: string;
      featured?: boolean;
      breaking?: boolean;
      readTime?: string;
      tags?: string[];
    };
  };
  priority?: boolean;
}

const { article, priority = false } = Astro.props;
const { data } = article;
const slug = article.id ? article.id.replace(/\.md$/, '') : article.slug;

const formattedDate = new Intl.DateTimeFormat('es-MX', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'America/Mexico_City',
}).format(new Date(data.pubDate));
---

<article class="blog-card">
  <a href={`/noticias/${slug}`} class="card-media-link" aria-label={`Leer historia: ${data.title}`}>
    <div class="card-media">
      <img
        src={data.image}
        alt={data.imageCaption || data.title}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="card-img"
        onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=1200&q=80'"
      />
      {data.tags && data.tags.length > 0 && (
        <span class="card-tag">#{data.tags[0]}</span>
      )}
    </div>
  </a>

  <div class="card-body">
    <div class="card-meta">
      <time datetime={new Date(data.pubDate).toISOString()} class="card-date">{formattedDate}</time>
      <span class="meta-dot">·</span>
      <span class="card-read-time">{data.readTime || '4 min'} de lectura</span>
    </div>

    <h2 class="card-title">
      <a href={`/noticias/${slug}`}>{data.title}</a>
    </h2>

    <p class="card-excerpt">
      {data.excerpt || data.subtitle || ''}
    </p>

    <div class="card-footer">
      <div class="card-author">
        <span class="author-name">{data.author}</span>
      </div>
      <a href={`/noticias/${slug}`} class="card-read-more" aria-label={`Leer más: ${data.title}`}>
        <span>Leer</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </a>
    </div>
  </div>
</article>

<style>
  .blog-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(199, 67, 104, 0.35);
  }

  .card-media-link {
    display: block;
    overflow: hidden;
  }

  .card-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-pink-soft);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .blog-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(82, 36, 47, 0.9);
    backdrop-filter: blur(6px);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .card-body {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--color-muted);
    margin-bottom: 0.6rem;
    font-weight: 500;
  }

  .meta-dot {
    color: var(--color-magenta);
  }

  .card-title {
    font-size: 1.25rem;
    font-family: var(--font-serif);
    color: var(--color-wine-dark);
    line-height: 1.35;
    margin-bottom: 0.65rem;
  }

  .card-title a:hover {
    color: var(--color-magenta);
  }

  .card-excerpt {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-soft);
    margin-bottom: 1.2rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .card-author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .author-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-pink-soft);
    color: var(--color-magenta);
    font-size: 0.8rem;
    font-weight: bold;
  }

  .author-name {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-wine);
  }

  .card-read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-magenta);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .card-read-more:hover {
    color: var(--color-wine-dark);
  }
</style>
